{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "hardhat.config.ts",
    "src",
    "test",
    "test-helpers",
    "build/artifacts/**/*.d.ts"
  ]
}
