{
  "extends": "./tsconfig",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "noEmit": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
