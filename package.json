{
  "name": "@zodiaceco/core-contracts",
  "version": "5.0.0",
  "description": "Base contracts for building Zodiac modules, modifiers and guards, with helpers to encode, deploy and verify them.",
  "author": "Auryn Macmillan <auryn@gnosisguild.org>",
  "license": "LGPL-3.0+",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "tooling": [
        "dist/esm/tooling.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./tooling": {
      "types": "./dist/esm/tooling.d.ts",
      "import": "./dist/esm/tooling.js",
      "require": "./dist/cjs/tooling.js"
    },
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "dist",
    "contracts"
  ],
  "scripts": {
    "clean": "rm -rf dist build",
    "compile": "bun scripts/compile.ts",
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "postbuild": "bun postbuild.mjs",
    "test": "bun run compile && bun test",
    "typecheck": "bun run compile && tsc -p tsconfig.json --noEmit",
    "format": "bun run format:sol && bun run format:ts",
    "format:sol": "prettier --write --plugin=prettier-plugin-solidity ./contracts/**/*.sol",
    "format:ts": "prettier --write ./src/**/*.ts ./test/**/*.ts ./scripts/**/*.ts"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zodiaceco/zodiac-core.git"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "prettier": "3.10.1",
    "prettier-plugin-solidity": "2.5.0",
    "solc": "0.8.30",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "viem": "^2.58.8"
  },
  "packageManager": "bun@1.4.5"
}
